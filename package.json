{
  "name": "freight-intent-broker",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:api & npm run dev:web",
    "dev:api": "npm run dev -w @fib/api",
    "dev:web": "npm run dev -w @fib/web",
    "build": "npm run build -w @fib/shared && npm run build -w @fib/contracts && npm run build -ws --if-present",
    "lint": "npm run lint -ws --if-present",
    "db:generate": "npm run db:generate -w @fib/api",
    "db:migrate": "npm run db:migrate -w @fib/api",
    "db:seed": "npm run db:seed -w @fib/api",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
